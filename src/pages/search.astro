---
import DocLayout from "@layouts/DocLayout.astro";
import searchIndex from "../data/search-index.json";
import booklet from "../data/booklet-data.json";
import { getCollection } from "astro:content";

const episodes = (await getCollection("episodes")).sort((a, b) => b.data.episode - a.data.episode);
const index = new Map(searchIndex.map(item => [item.episode, item]));
const categoriesByEpisode = new Map<number, Set<string>>();
for (const [category, findings] of Object.entries(booklet.bugs_by_type)) {
  for (const { episode } of findings) {
    if (!categoriesByEpisode.has(episode)) categoriesByEpisode.set(episode, new Set());
    categoriesByEpisode.get(episode)!.add(category);
  }
}
const filters = Object.entries(booklet.bug_type_counts).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([name]) => name);
---

<DocLayout title="Search the archive" section="search">
  <div class="search-page">
    <header class="page-heading">
      <p class="page-kicker">EPISODE INDEX / 001–{episodes[0].data.episode}</p>
      <h1>Search episodes</h1>
      <p>Find any of the {episodes.length} summaries by episode number, title, topic, or keyword.</p>
    </header>

    <section class="search-panel" aria-label="Search and sort">
      <label for="searchInput">Find in the archive</label>
      <form action="/search/" method="get" role="search" class="query-form">
        <input type="search" name="q" id="searchInput" placeholder="Try “cloud” or “201”" autocomplete="off" />
        <button type="button" id="clearSearch" hidden>Clear</button>
      </form>
      <div class="quick-filters" aria-label="Suggested topics">
        <span>Topics</span>
        {filters.map((type) => <button type="button" data-filter={type} aria-pressed="false">{type}</button>)}
      </div>
    </section>

    <div class="results-toolbar">
      <p id="searchHint" role="status" aria-live="polite">{episodes.length} episodes</p>
      <div class="sort"><label for="resultOrder">Order</label><select id="resultOrder"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></div>
    </div>
    <div class="empty-state" id="noResults" hidden>
      <h2>No matching episodes</h2>
      <p>Try a different topic, a shorter phrase, or an episode number.</p>
      <button type="button" id="resetSearch">Show all episodes</button>
    </div>
    <ol class="search-results" id="searchResults" role="list">
      {episodes.map(({ data }) => {
        const meta = index.get(data.episode);
        const snippet = meta?.snippet?.replace(`Episode ${data.episode} ${data.title}`, "").replace(/^\s*TL;DR\s*-?\s*/, "").trim();
        const categories = [...(categoriesByEpisode.get(data.episode) ?? [])];
        const keywords = (meta?.keywords ?? []).filter(keyword => !/^(guests?|hosts?|target\/context|root cause|description|technique|impact|key technical details|exploitation steps).*:$/i.test(keyword));
        return (
          <li data-episode={data.episode} data-search={[data.title, data.description, snippet, ...categories, ...keywords].join(" ")}>
            <a href={`/blog/${data.episode}/`} class="search-result">
              <span class="result-number">{String(data.episode).padStart(3,"0")}</span>
              <div class="result-copy">
                <h2>{data.title}</h2>
                {(data.description || snippet) && <p>{data.description ?? snippet}</p>}
                {categories.length > 0 && <span class="result-tags">{categories.slice(0, 3).join(" · ")}</span>}
              </div>
              <span class="result-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</DocLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#searchInput")!;
  const hint = document.querySelector<HTMLElement>("#searchHint")!;
  const results = document.querySelector<HTMLOListElement>("#searchResults")!;
  const items = [...results.querySelectorAll<HTMLLIElement>("li[data-episode]")];
  const filterTags = document.querySelectorAll<HTMLButtonElement>("button[data-filter]");
  const clear = document.querySelector<HTMLButtonElement>("#clearSearch")!;
  const reset = document.querySelector<HTMLButtonElement>("#resetSearch")!;
  const empty = document.querySelector<HTMLElement>("#noResults")!;
  const order = document.querySelector<HTMLSelectElement>("#resultOrder")!;
  const normalize = (value: string) => value.toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu,"").trim();

  function filterResults(save = false) {
    const query = normalize(input.value);
    const episode = query.match(/^(?:ep(?:isode)?[ .#]*)?#?0*(\d+)$/i)?.[1];
    let count = 0;
    for (const item of items) {
      item.hidden = !!query && (episode ? item.dataset.episode !== episode : !normalize(item.dataset.search ?? "").includes(query));
      if (!item.hidden) count++;
    }
    for (const tag of filterTags) tag.setAttribute("aria-pressed", String(query === normalize(tag.dataset.filter ?? "")));
    hint.textContent = query ? `${count} result${count === 1 ? "" : "s"}` : `${items.length} episodes`;
    empty.hidden = count > 0;
    clear.hidden = !input.value;
    if (save) {
      const url = new URL(location.href);
      if (query) url.searchParams.set("q", input.value.trim());
      else url.searchParams.delete("q");
      try { history.replaceState(null, "", url); } catch { /* sandboxed previews may deny URL updates */ }
    }
  }

  input.value = new URLSearchParams(location.search).get("q") ?? "";
  filterResults();
  const update = () => filterResults(true);
  input.addEventListener("input", update);
  input.form?.addEventListener("submit", (event) => { event.preventDefault(); update(); });
  const resetQuery = () => { input.value = ""; update(); input.focus(); };
  clear.addEventListener("click", resetQuery);
  reset.addEventListener("click", resetQuery);
  for (const tag of filterTags) tag.addEventListener("click", () => {
    input.value = tag.getAttribute("aria-pressed") === "true" ? "" : tag.dataset.filter ?? "";
    update();
  });
  order.addEventListener("change", () => results.append(...(order.value === "oldest" ? [...items].reverse() : items)));
</script>

<style>
  .search-page { max-width: 76rem; margin-inline: auto; }
  .search-panel { margin-top: 1.5rem; background: var(--bg-code); border: 1px solid var(--border); padding: clamp(.85rem, 2vw, 1.5rem); }
  .search-panel label { display: block; margin-bottom: .35rem; color: var(--text); font-size: var(--text-sm); font-weight: 700; }
  .query-form { display: flex; gap: .45rem; }
  .query-form input, .sort select { min-height: 44px; min-width: 0; padding: .55rem .7rem; border: 1px solid var(--border-hover); border-radius: var(--radius-xs); background: var(--bg-elevated); color: var(--text); }
  .query-form input { flex: 1; }
  button { min-height: 44px; border: 1px solid var(--border); background: var(--bg-elevated); color: var(--text); border-radius: var(--radius-xs); padding: .25rem .65rem; cursor: pointer; font-size: var(--text-sm); }
  button:hover, button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
  button[aria-pressed="true"] { background: var(--accent-bg); }
  .quick-filters { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; margin-top: .7rem; }
  .quick-filters span, .result-number, .result-tags { font: 500 var(--text-xs)/1.4 var(--font-mono); }
  .quick-filters span { color: var(--text-tertiary); margin-right: .2rem; }
  .quick-filters button { font-size: var(--text-xs); overflow-wrap: anywhere; }
  .results-toolbar, .sort { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .results-toolbar { justify-content: space-between; margin: .85rem 0 .55rem; }
  .results-toolbar p, .sort label, .sort select { font-size: var(--text-sm); color: var(--text-secondary); margin: 0; }
  .search-results { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .search-results li { margin: 0; border-bottom: 1px solid var(--border); }
  .search-result { display: grid; grid-template-columns: 2.8rem minmax(0, 1fr) auto; gap: .6rem; padding: .85rem .55rem; color: var(--text); }
  .search-result:hover { background: var(--bg-hover); }
  .result-number, .result-arrow { color: var(--accent); padding-top: .15rem; }
  .result-copy h2 { margin: 0; font: 700 clamp(1.05rem, 1rem + .45vw, 1.35rem)/1.25 var(--font-display); }
  .result-copy p { font-size: var(--text-sm); color: var(--text-secondary); margin: .3rem 0 0; max-width: 75ch; overflow-wrap: anywhere; }
  .result-tags { display: block; color: var(--text-tertiary); margin-top: .3rem; }
  .empty-state { border: 1px dashed var(--border-hover); text-align: center; padding: 2rem .75rem; margin-top: .75rem; }
  .empty-state h2 { margin: 0; }
  .empty-state p { margin: .5rem 0 1rem; color: var(--text-secondary); }
  @media (max-width: 480px) { .search-result { grid-template-columns: 1.75rem minmax(0,1fr) auto; gap: .35rem; padding-inline: .2rem; } }
</style>
