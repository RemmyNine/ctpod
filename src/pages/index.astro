---
import DocLayout from "@layouts/DocLayout.astro";
import { getCollection } from "astro:content";
import booklet from "../data/booklet-data.json";

const episodes = (await getCollection("episodes")).sort((a, b) => b.data.episode - a.data.episode);
const [featured, ...recent] = episodes.slice(0, 7);
const formatDate = (value: Date) => new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(value);
---

<DocLayout title="Critical Thinking Bug Bounty Podcast" section="archive">
  <div class="archive">
    <section class="archive-hero" aria-labelledby="archive-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="signal-dot"></span> THE PODCAST ARCHIVE</p>
        <h1 id="archive-title">Critical<br />Thinking<span>.</span></h1>
        <p class="hero-sub">The Bug Bounty Podcast, indexed. Explore episode summaries, security research, and lessons from the people doing the work.</p>
        <div class="hero-actions">
          <a class="action action-primary" href={`/blog/${featured.data.episode}/`}>Read the latest episode <span aria-hidden="true">↗</span></a>
          <a class="action" href="/search/">Search the archive <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="archive-cover">
        <img src="/archive-cover.webp" alt="" width="720" height="540" fetchpriority="high" />
        <figcaption><span>CRITICAL THINKING</span><span>EP. 001–{featured.data.episode}</span></figcaption>
      </figure>
    </section>

    <dl class="archive-stats" aria-label="Archive statistics">
      <div><dt>Episodes</dt><dd>{episodes.length}</dd></div>
      <div><dt>Vulnerability categories</dt><dd>{Object.keys(booklet.bugs_by_type).length}</dd></div>
      <div><dt>Indexed concepts</dt><dd>{booklet.total_techniques}</dd></div>
    </dl>

    <section class="archive-issues" aria-labelledby="latest-title">
      <div class="section-line">
        <h2 id="latest-title">Latest episodes</h2>
        <a href="/search/">All episodes <span aria-hidden="true">↗</span></a>
      </div>
      <div class="issue-grid">
        <article class="featured-issue">
          <p class="eyebrow">LATEST RELEASE <span class="issue-sep">/</span> EP. {featured.data.episode}</p>
          <h3><a href={`/blog/${featured.data.episode}/`}>{featured.data.title}</a></h3>
          {featured.data.description && <p class="featured-desc">{featured.data.description}</p>}
          <div class="featured-foot">
            {featured.data.date && <time datetime={featured.data.date.toISOString().slice(0,10)}>{formatDate(featured.data.date)}</time>}
            <a href={`/blog/${featured.data.episode}/`}>Read summary <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <ol class="issue-list" aria-label="Recent episodes">
          {recent.map(({ data }) => (
            <li><a href={`/blog/${data.episode}/`}><span class="issue-number">{data.episode}</span><span>{data.title}</span><span class="issue-arrow" aria-hidden="true">↗</span></a></li>
          ))}
        </ol>
      </div>
    </section>

    <footer class="archive-foot">
      <p>An independent companion to the <a href="https://www.criticalthinkingpodcast.io/">Critical Thinking Bug Bounty Podcast</a>. Summaries are AI-assisted; verify important claims against the original episodes.</p>
      <a href="https://x.com/NineRemmy">Built by Remmy9 <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</DocLayout>

<style>
  .archive { --rule: var(--border); }
  .archive-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .85fr); align-items: center; gap: clamp(1.5rem, 5vw, 5rem); padding: 1rem 0 2.5rem; }
  .eyebrow, figcaption, .issue-number { font: 500 var(--text-xs)/1.5 var(--font-mono); letter-spacing: .08em; }
  .eyebrow { display: flex; align-items: center; gap: .6rem; color: var(--accent); margin: 0 0 1rem; }
  .signal-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--accent); }
  h1 { font: 700 clamp(3.2rem, 7.3vw, 7.35rem)/.83 var(--font-display); letter-spacing: -.07em; margin: 0 0 1.4rem; }
  h1 span { color: var(--accent); }
  .hero-sub { color: var(--text-secondary); max-width: 40ch; font-size: var(--text-base); margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.4rem; }
  .action { display: inline-flex; min-height: 44px; align-items: center; justify-content: space-between; gap: .7rem; padding: .55rem .8rem; color: var(--text); border: 1px solid var(--rule); border-radius: var(--radius-xs); font-size: var(--text-sm); }
  .action:hover { background: var(--bg-hover); }
  .action-primary { background: var(--ink); color: white; border-color: var(--ink); }
  .action-primary:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .archive-cover { margin: 0; border: 1px solid var(--rule); background: var(--bg-elevated); min-width: 0; padding: .55rem; }
  .archive-cover img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0; background: #b94920; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .35rem; padding: .65rem .2rem .1rem; color: var(--text-tertiary); }
  .archive-stats { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); border-block: 1px solid var(--rule); margin: 0; }
  .archive-stats div { display: flex; flex-direction: column-reverse; padding: 1rem 1.25rem; }
  .archive-stats div:first-child { padding-left: 0; }
  .archive-stats div + div { border-left: 1px solid var(--rule); }
  dt { font: 500 var(--text-xs)/1.5 var(--font-mono); color: var(--text-secondary); }
  dd { font: 700 var(--text-xl)/1.2 var(--font-display); margin: 0; }
  .archive-issues { padding-top: 1.9rem; }
  .section-line { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
  .section-line h2 { margin: 0; font: 700 var(--text-xl)/1.1 var(--font-display); }
  .section-line a, .archive-foot, .featured-foot { font-size: var(--text-sm); }
  .issue-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 1rem; }
  .featured-issue { display: flex; flex-direction: column; padding: clamp(1.05rem, 2.5vw, 2rem); background: var(--bg-code); border: 1px solid var(--rule); }
  .issue-sep { color: var(--text-tertiary); }
  .featured-issue h3 { font: 700 var(--text-xl)/1.1 var(--font-display); margin: 0; }
  .featured-issue h3 a { color: var(--text); font-weight: inherit; }
  .featured-issue h3 a:hover { color: var(--accent); }
  .featured-desc { color: var(--text-secondary); }
  .featured-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; margin-top: auto; padding-top: 1rem; }
  .featured-foot time { color: var(--text-secondary); }
  .issue-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .issue-list li { margin: 0; border-bottom: 1px solid var(--rule); }
  .issue-list a { display: grid; grid-template-columns: 2.15rem minmax(0,1fr) auto; gap: .5rem; align-items: center; min-height: 44px; padding: .45rem .5rem; color: var(--text); font-size: var(--text-sm); }
  .issue-list a:hover { background: var(--bg-hover); }
  .issue-number, .issue-arrow { color: var(--accent); }
  .archive-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-top: 1px solid var(--rule); color: var(--text-secondary); margin-top: 2rem; padding-top: .75rem; }
  .archive-foot p { margin: 0; max-width: 65ch; }
  .archive-foot > a { white-space: nowrap; }
  @media (max-width: 850px) { .archive-hero { gap: 1rem; } }
  @media (max-width: 610px) {
    .archive-hero, .issue-grid { grid-template-columns: 1fr; }
    .archive-hero { padding: .75rem 0 1.5rem; gap: 1.5rem; }
    .archive-cover img { aspect-ratio: 2 / 1; object-position: center 42%; }
    .archive-stats div { padding: .7rem .55rem; }
    .archive-stats dt { min-height: 3em; }
    .archive-foot { flex-direction: column; }
  }
</style>
