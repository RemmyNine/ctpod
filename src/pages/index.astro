---
import DocLayout from "@layouts/DocLayout.astro";
import { getCollection } from "astro:content";
import booklet from "../data/booklet-data.json";

const episodes = (await getCollection("episodes")).sort((a,b) => b.data.episode - a.data.episode);
const [lead, ...recent] = episodes.slice(0, 7).map(ep => ep.data);
const date = (d: Date) => new Intl.DateTimeFormat("en", {month:"short",day:"numeric", year:"numeric",timeZone:"UTC"}).format(d);
const [headline, guest] = lead.title.split(/\s+w\/\s+/i);
---
<DocLayout title="Critical Thinking Bug Bounty Podcast" section="archive">
  <div class="home-intro">
    <div><p class="kicker">CRITICAL THINKING / BUG BOUNTY PODCAST</p><h1>Episode archive<span>.</span></h1></div>
    <form class="home-search" action="/search/" role="search">
      <label for="home-q">Search all {episodes.length} episodes</label>
      <div><input type="search" name="q" id="home-q" placeholder="Topic, title, or episode number" required /><button type="submit" aria-label="Search the archive"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.7"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.7"/></svg></button></div>
    </form>
  </div>
  <article class="cover">
    <div class="cover-copy">
      <p class="kicker"><span class="on-air"></span> LATEST EPISODE <span class="cover-id">/ {lead.episode}</span></p>
      <h2><a href={`/blog/${lead.episode}/`}>{headline}</a></h2>
      <div class="cover-byline">{guest && <span>With {guest}</span>}{lead.date && <time datetime={lead.date.toISOString().slice(0,10)}>{date(lead.date)}</time>}</div>
      <a class="read-link" href={`/blog/${lead.episode}/`}>Read episode summary <span aria-hidden="true">→</span></a>
    </div>
    <div class="cover-art"><img src="/archive-cover.webp" width="720" height="540" alt="" fetchpriority="high" /><span aria-hidden="true">CT / {lead.episode}</span></div>
  </article>
  <div class="lower-grid">
    <section aria-labelledby="recent-title">
      <header class="section-head"><h2 id="recent-title">Recent episodes</h2><a href="/search/">View all {episodes.length} <span aria-hidden="true">→</span></a></header>
      <ol class="ledger" role="list">{recent.map(ep => <li><a href={`/blog/${ep.episode}/`}>
        <span class="ep-no">{ep.episode}</span><span class="ep-title">{ep.title}</span>
        {ep.date && <time datetime={ep.date.toISOString().slice(0,10)}>{date(ep.date)}</time>}<span class="arrow" aria-hidden="true">↗</span>
      </a></li>)}</ol>
    </section>
    <aside class="shelf" aria-labelledby="shelf-title">
      <p class="kicker">REFERENCE SHELF</p><h2 id="shelf-title">Beyond the episodes</h2>
      <a href="/booklet/"><strong>Reference booklet <span>↗</span></strong><small>Browse {booklet.total_techniques} indexed concepts and their episode references.</small></a>
    </aside>
  </div>
  <footer class="colophon"><p>An independent companion to the <a href="https://www.criticalthinkingpodcast.io/">Critical Thinking Bug Bounty Podcast</a>. Check AI-assisted summaries against the original recordings.</p><a href="https://x.com/NineRemmy">Built by Remmy9 ↗</a></footer>
</DocLayout>
<style>
  .home-intro,.section-head,.colophon,.cover-byline{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .home-intro{margin:0 0 1.7rem;align-items:end}
  .kicker,.ep-no,.ledger time,.cover-art span{font:500 var(--text-xs)/1.4 var(--font-mono);letter-spacing:.065em}
  .kicker{margin:0 0 .6rem;color:var(--text-tertiary);}
  h1,h2,.ep-title,.shelf strong{font-family:var(--font-display);font-weight:700}
  h1{font-size:clamp(2.5rem,5vw,4.7rem);letter-spacing:-.055em;line-height:.98}h1 span{color:var(--accent)}
  .home-search{width:min(19rem,38%)}.home-search label{display:block;font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:.32rem}
  .home-search div{display:flex;background:var(--bg-elevated);border:1px solid var(--border-hover);border-radius:5px}
  .home-search input,.home-search button{border:0;background:none;min-height:44px}.home-search input{width:0;flex:1;padding:0 .7rem;font-size:var(--text-sm);color:var(--text)}.home-search button{display:grid;place-items:center;cursor:pointer;color:var(--accent);width:44px}
  .cover{display:grid;grid-template-columns:1.18fr 1fr;background:#202723;color:#faf6ed;border-radius:8px;overflow:hidden}
  .cover-copy{padding:clamp(1.45rem,3.5vw,3.5rem);align-self:center}.cover .kicker{color:#ffb78d;display:flex;align-items:center;gap:.55rem}.on-air{width:.5rem;height:.5rem;border-radius:50%;background:#ff925b}.cover-id{color:#c6c9bb}
  .cover h2{font-size:clamp(2.55rem,4.9vw,4.95rem);line-height:.98;letter-spacing:-.051em;margin:.95rem 0;max-width:16ch;color:inherit}
  .cover h2 a{color:inherit;font-weight:inherit}.cover h2 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.08em}
  .cover-byline{justify-content:start;flex-wrap:wrap;gap:.45rem 1rem;color:#d2d4c8;font-size:var(--text-sm)}.cover-byline time{color:#c4c8bd}
  .read-link{margin-top:1.35rem;display:inline-flex;gap:1.1rem;align-items:center;min-height:44px;border-radius:4px;background:#ffd7ba;color:#24251f;padding:.65rem .9rem;font-size:var(--text-sm);font-weight:700}.read-link:hover{background:#fff0df;color:#222}
  .cover-art{position:relative;min-height:100%;background:#c25621}.cover-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 46%;border-radius:0}.cover-art span{position:absolute;bottom:.85rem;right:1rem;color:white;background:#252720;padding:.23rem .45rem}
  .lower-grid{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(13rem,1fr);align-items:start;gap:clamp(1.3rem,4vw,3.7rem);margin:2.35rem 0 2.5rem}
  .section-head{padding-bottom:.65rem;border-bottom:2px solid var(--text)}.section-head h2,.shelf h2{font-size:var(--text-xl);line-height:1.1;letter-spacing:-.035em;margin:0}.section-head a{font-size:var(--text-sm);white-space:nowrap}
  .ledger{margin:0;padding:0;list-style:none}.ledger li{margin:0;border-bottom:1px solid var(--border)}.ledger a{color:var(--text);display:grid;grid-template-columns:2.6rem 1fr auto 1rem;align-items:center;gap:.8rem;min-height:4.2rem;padding:.55rem .2rem}.ledger a:hover{background:var(--bg-hover)}
  .ep-no,.arrow{color:var(--accent)}.ep-title{font-size:clamp(1.1rem,1.4vw,1.4rem);line-height:1.15}.ledger time{letter-spacing:0;color:var(--text-tertiary);white-space:nowrap}
  .shelf{background:#eeece2;border:1px solid var(--border);border-radius:6px;padding:clamp(1rem,2.2vw,1.75rem)}.shelf h2{font-size:1.65rem;margin:0 0 1rem}.shelf a{display:block;border-top:1px solid var(--border);padding:.8rem 0;color:var(--text)}.shelf a:last-child{padding-bottom:0}.shelf a:hover strong{color:var(--accent)}.shelf strong{display:flex;justify-content:space-between;align-items:center;font-size:1.08rem}.shelf strong span{color:var(--accent)}.shelf small{display:block;color:var(--text-secondary);font-size:var(--text-sm);line-height:1.45;margin-top:.22rem}
  .colophon{border-top:1px solid var(--border);padding-top:1rem;font-size:var(--text-sm);color:var(--text-secondary)}.colophon p{margin:0;max-width:70ch}.colophon>a{white-space:nowrap}
  @media(max-width:760px){.lower-grid{grid-template-columns:1fr}.home-intro{align-items:start}.cover{grid-template-columns:1.4fr 1fr}.ledger a{min-height:3.8rem}}
  @media(max-width:580px){.home-intro{display:block;margin-bottom:1rem}.home-search{width:100%;margin-top:.8rem}.home-search label{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}.cover{grid-template-columns:minmax(0,1fr) 20%}.cover h2{font-size:clamp(1.9rem,8vw,2.7rem)}.cover-copy{padding:1.2rem .9rem}.cover-art img{object-position:50%}.cover-art span{display:none}.cover-byline{gap:.2rem .65rem;font-size:.84rem}.read-link{margin-top:.8rem}.lower-grid{margin-top:1.5rem}.ledger a{grid-template-columns:2rem minmax(0,1fr) 1rem;gap:.55rem}.ledger time{display:none}.colophon{display:block}.colophon>a{display:inline-block;margin-top:.5rem}}
</style>
