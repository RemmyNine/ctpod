---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  currentEpisode?: number;
  section?: "archive" | "search" | "booklet";
  description?: string;
}

const sorted = (await getCollection("episodes")).sort((a, b) => b.data.episode - a.data.episode);
const { title, currentEpisode, section, description } = Astro.props;
const nav = [
  { id: "archive", label: "Archive", href: "/" },
  { id: "search", label: "Search", href: "/search/" },
  { id: "booklet", label: "Booklet", href: "/booklet/" },
];
const number = (n: number) => String(n).padStart(3, "0");
---

<BaseLayout title={title} description={description}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="masthead">
    <div class="brand-area">
      <button type="button" class="episode-toggle" aria-controls="episode-sidebar" aria-expanded="false" aria-label="Open episode list">
        <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/></svg>
        <span>Index</span>
      </button>
      <a href="/" class="masthead-brand">
        <img src="/favicon.svg" width="29" height="29" alt="" />
        <span>CTBBP <span class="wordmark-sub">Archive</span></span>
      </a>
    </div>
    <nav class="masthead-nav" aria-label="Main navigation">
      {nav.map(({ id, label, href }) => <a href={href} aria-current={section === id ? "page" : undefined}>{label}</a>)}
    </nav>
    <a href="https://www.criticalthinkingpodcast.io/" target="_blank" rel="noopener" class="masthead-source">Original podcast <span aria-hidden="true">↗</span></a>
  </header>

  <div class="archive-shell">
    <aside class="episode-rail" id="episode-sidebar" aria-labelledby="rail-title">
      <div class="rail-header">
        <div class="rail-label"><h2 id="rail-title">Episode index</h2><span>{sorted.length}</span></div>
        <button type="button" class="rail-close" aria-label="Close episode list">×</button>
        <label class="visually-hidden" for="rail-search">Find an episode</label>
        <div class="rail-input-wrap">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="5.75" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <input type="search" id="rail-search" autocomplete="off" placeholder="Find an episode…" />
        </div>
      </div>
      <nav class="rail-scroll" aria-label="Episode index">
        <ul class="rail-list" role="list">
          {sorted.map(({ data }) => (
            <li data-episode={data.episode} data-title={data.title}>
              <a href={`/blog/${data.episode}/`} aria-current={currentEpisode === data.episode ? "page" : undefined}>
                <span class="rail-number">{number(data.episode)}</span><span class="rail-title" title={data.title}>{data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="rail-empty" hidden role="status">No episodes match.</p>
      </nav>
      <div class="rail-foot">INDEPENDENT PODCAST INDEX</div>
    </aside>
    <button type="button" class="rail-backdrop" aria-label="Close episode list" tabindex="-1" hidden></button>
    <main id="main-content" class="main-content" tabindex="-1"><slot /></main>
  </div>

  <script>
    const rail = document.querySelector<HTMLElement>(".episode-rail");
    const toggle = document.querySelector<HTMLButtonElement>(".episode-toggle");
    const close = document.querySelector<HTMLButtonElement>(".rail-close");
    const backdrop = document.querySelector<HTMLButtonElement>(".rail-backdrop");
    const input = document.querySelector<HTMLInputElement>("#rail-search");
    const rows = document.querySelectorAll<HTMLElement>(".rail-list [data-episode]");
    const empty = document.querySelector<HTMLElement>(".rail-empty");
    const main = document.querySelector<HTMLElement>(".main-content");
    const masthead = document.querySelector<HTMLElement>(".masthead");
    const skip = document.querySelector<HTMLElement>(".skip-link");

    function setRail(open: boolean, focus = false) {
      if (!rail || !toggle || !backdrop) return;
      rail.dataset.open = String(open);
      rail.inert = !open;
      if (main) main.inert = open;
      if (masthead) masthead.inert = open;
      if (skip) skip.inert = open;
      if (open) {
        rail.setAttribute("role", "dialog");
        rail.setAttribute("aria-modal", "true");
      } else {
        rail.removeAttribute("role");
        rail.removeAttribute("aria-modal");
      }
      backdrop.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close episode list" : "Open episode list");
      if (focus) (open ? input : toggle)?.focus();
    }

    setRail(false);
    toggle?.addEventListener("click", () => setRail(toggle.getAttribute("aria-expanded") !== "true", true));
    close?.addEventListener("click", () => setRail(false, true));
    backdrop?.addEventListener("click", () => setRail(false, true));
    document.addEventListener("keydown", (event) => {
      if (toggle?.getAttribute("aria-expanded") !== "true") return;
      if (event.key === "Escape") setRail(false, true);
      if (event.key === "Tab") {
        const last = [...(rail?.querySelectorAll<HTMLAnchorElement>(".rail-list li:not([hidden]) a") ?? [])].at(-1) ?? input;
        if (event.shiftKey && document.activeElement === close && last) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          close?.focus();
        }
      }
    });
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      const ep = query.match(/^(?:ep(?:isode)?[ .#]*)?#?0*(\d+)$/i)?.[1];
      let count = 0;
      for (const row of rows) {
        row.hidden = !!query && (ep ? row.dataset.episode !== ep : !row.dataset.title?.toLowerCase().includes(query));
        if (!row.hidden) count++;
      }
      if (empty) empty.hidden = count > 0;
    });
  </script>
</BaseLayout>

<style>
  .visually-hidden, .skip-link:not(:focus) { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip-link:focus { position: fixed; top: .5rem; left: .5rem; z-index: 20; padding: .5rem .75rem; background: var(--bg-elevated); }
  .masthead { --header-height: 4.25rem; position: sticky; z-index: 8; top: 0; min-height: var(--header-height); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 0 1.65rem; border-bottom: 1px solid var(--border); background: var(--bg); }
  .brand-area, .masthead-brand, .masthead-nav { display: flex; align-items: center; }
  .masthead-brand { color: var(--text); gap: .55rem; white-space: nowrap; font-size: var(--text-base); font-weight: 700; }
  .masthead-brand img { border-radius: 0; }
  .wordmark-sub { color: var(--text-tertiary); font-weight: 500; }
  .masthead-nav { align-self: stretch; gap: .25rem; }
  .masthead-nav a { position: relative; display: grid; place-items: center; min-height: 44px; padding: 0 .8rem; color: var(--text-secondary); font-size: var(--text-sm); }
  .masthead-nav a:hover, .masthead-nav a[aria-current] { color: var(--accent); }
  .masthead-nav a[aria-current]::after { position: absolute; inset: auto .8rem -1px; content: ""; height: 2px; background: var(--accent); }
  .masthead-source { justify-self: end; color: var(--text); font-size: var(--text-sm); }
  .masthead-source span { color: var(--accent); margin-left: .2rem; }
  .episode-toggle, .rail-close { display: none; border: 0; background: transparent; color: inherit; cursor: pointer; }
  .archive-shell { display: grid; grid-template-columns: 16.4rem minmax(0, 1fr); min-height: calc(100dvh - 4.25rem); }
  .episode-rail { --rail-text: #eeeae0; --rail-dim: #b8b7aa; --rail-accent: #ffad89; display: flex; flex-direction: column; position: sticky; top: 4.25rem; height: calc(100dvh - 4.25rem); background: var(--ink); color: var(--rail-text); min-width: 0; }
  .episode-rail :focus-visible { outline-color: var(--rail-accent); }
  .rail-header { position: relative; padding: 1.15rem .9rem .8rem; }
  .rail-label { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; }
  .rail-label h2, .rail-label span, .rail-foot { font: 500 var(--text-xs)/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .07em; color: var(--rail-dim); margin: 0; }
  .rail-label span { color: var(--rail-accent); padding-left: .5rem; }
  .rail-input-wrap { position: relative; color: var(--rail-dim); }
  .rail-input-wrap svg { position: absolute; top: 50%; left: .65rem; translate: 0 -50%; pointer-events: none; }
  .rail-input-wrap input { width: 100%; min-height: 44px; background: #292d27; color: var(--rail-text); border: 1px solid #52574e; border-radius: var(--radius-xs); font-size: var(--text-sm); padding: .44rem .5rem .44rem 2rem; color-scheme: dark; }
  .rail-input-wrap input::placeholder { color: var(--rail-dim); }
  .rail-scroll { position: relative; flex: 1; overflow: auto; padding: 0 .55rem; color-scheme: dark; scrollbar-width: thin; }
  .rail-list { list-style: none; margin: 0; padding: 0; }
  .rail-list li { margin: 0; border-top: 1px solid #ffffff12; }
  .rail-list a { min-height: 44px; display: grid; grid-template-columns: 2rem minmax(0, 1fr); align-items: center; gap: .35rem; padding: .34rem .35rem; color: var(--rail-text); font-size: var(--text-sm); line-height: 1.25; }
  .rail-list a:hover, .rail-list a[aria-current] { background: #38382f; color: var(--rail-accent); }
  .rail-number { font: 500 var(--text-xs)/1.3 var(--font-mono); color: var(--rail-dim); }
  .rail-title { overflow-wrap: anywhere; }
  .rail-empty { padding: .5rem; color: var(--rail-dim); font-size: var(--text-sm); }
  .rail-foot { padding: .9rem; border-top: 1px solid #ffffff24; }
  .main-content { width: 100%; min-width: 0; max-width: 91rem; margin-inline: auto; padding: clamp(1.25rem, 3.25vw, 3.45rem) clamp(1rem, 4vw, 4rem) 3rem; }
  .main-content:focus { outline: none; }
  .rail-backdrop { display: none; }
  @media (max-width: 800px) {
    .masthead { padding: 0 .85rem; grid-template-columns: 1fr auto; gap: .3rem; }
    .masthead-source { display: none; }
    .masthead-nav a { padding: 0 .48rem; }
    .masthead-nav a[aria-current]::after { inset-inline: .48rem; }
  }
    .archive-shell { display: block; }
    .episode-toggle { display: flex; align-items:center; justify-content:center; gap:.35rem; min-width:44px; height:44px; padding:0 .8rem; margin-right:.85rem; border-right:1px solid var(--border); border-radius:0; font-size:var(--text-sm); }
    .episode-rail { position: fixed; z-index: 11; left: 0; top: 0; width: min(26rem, 90vw); height: 100dvh; visibility: hidden; }
    .episode-rail[data-open="true"] { visibility: visible; }
    .rail-label { padding-right: 2.85rem; min-height: 1.75rem; }
    .rail-close { display: grid; place-items: center; position: absolute; right: .55rem; top: .4rem; width: 44px; height: 44px; font-size: 1.6rem; }
    .rail-backdrop:not([hidden]) { display: block; position: fixed; z-index: 10; inset: 0; background: #1d211e88; border: 0; width: 100%; cursor: pointer; }
    :global(body):has(.episode-rail[data-open="true"]) { overflow: hidden; }
  @media(max-width:600px){.episode-toggle{margin:0 .15rem 0 -.4rem;padding:0;border:0}.episode-toggle span{display:none}}
  @media (max-width: 435px) { .wordmark-sub, .masthead-brand img { display: none; } .masthead-nav { gap: 0; } .masthead-nav a { font-size: .83rem; } }
  @media (max-width: 340px) { .masthead-nav a { padding-inline: .32rem; } .masthead-brand { font-size: .86rem; } }
</style>
